# Copy this file to .env and fill in real values before running.

# --- App ---
PORT=3000
SESSION_SECRET=replace-with-a-long-random-string
BASE_URL=http://localhost:3000
# Comma-separated Discord user IDs allowed into the ops dashboard.
# Get your own Discord ID: enable Developer Mode in Discord settings,
# right-click your name, "Copy User ID".
OPS_ADMIN_DISCORD_IDS=

# --- Discord OAuth (login for clippers) ---
# 1. https://discord.com/developers/applications -> New Application
# 2. OAuth2 -> add redirect: {BASE_URL}/auth/discord/callback
# 3. Copy Client ID / Client Secret below
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# --- TikTok Login Kit + Display API (auto view/like/comment tracking) ---
# 1. https://developers.tiktok.com/apps -> Create app
# 2. Add products: "Login Kit" and "Display API" (video.list scope)
# 3. Add redirect: {BASE_URL}/auth/tiktok/callback
# 4. TikTok reviews new apps before granting these scopes to real users -
#    this can take several days. Sandbox/test users work immediately.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# --- Instagram (via Meta Graph API, requires Instagram Business/Creator account) ---
# 1. https://developers.facebook.com/apps -> Create app -> type "Business"
# 2. Add product "Instagram Graph API"
# 3. Add redirect: {BASE_URL}/auth/instagram/callback
# 4. Clippers must convert their IG account to a Business or Creator
#    account and link it to a Facebook Page before connecting - this is
#    an Instagram/Meta requirement, not something this app can bypass.
# 5. Meta requires App Review before this works for non-test users.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
